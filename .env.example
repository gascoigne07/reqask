# Скопируйте этот файл в .env и впишите ключ. Файл .env в Git не попадает.
# Агент берёт первый заполненный вариант по порядку: LLM_*, GEMINI_*, ANTHROPIC_*, OPENAI_*, OLLAMA_*.
# Проверить ключ одним коротким вызовом: uv run main.py --check

# Вариант 1 (по умолчанию). Google Gemini, бесплатный тариф.
# Ключ: https://aistudio.google.com/ -> Get API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Запасные модели через запятую: агент переходит на следующую, если у текущей кончилась суточная квота
# или модель не отвечает. Значение none выключает.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash

# Вариант 2. Anthropic Claude через OpenAI-совместимый адрес.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-5-5

# Вариант 3. OpenAI. Без OPENAI_MODEL берётся gpt-6.2-sol.
# На этой модели проект не прогоняли: ключа OpenAI у нас нет.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=

# Вариант 4. Локальная модель через Ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=

# Вариант 5. Любой провайдер с OpenAI-совместимым API (DeepSeek, OpenRouter, vLLM и т.п.).
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Необязательные настройки (в скобках значения по умолчанию).
# LLM_TEMPERATURE=             # (не передаётся) для Gemini не отправляется никогда: модели 3.6+ его игнорируют
# LLM_REASONING_EFFORT=        # (по шагам: low для нарезки, medium для остальных) low | medium | high для всех шагов
# LLM_JSON_MODE=auto           # (auto) parse | schema | object | none; auto идёт по этому порядку, пока провайдер не примет
# LLM_MAX_RETRIES=5            # (5) повторы при минутном лимите 429, 5xx и обрывах связи
# LLM_MAX_REPAIRS=2            # (2) попытки исправить невалидный JSON
# LLM_TIMEOUT_SEC=240          # (240) таймаут одного запроса
# LLM_MIN_INTERVAL_SEC=        # (4 для Gemini, 0 для остальных) пауза между запросами в секундах
# LLM_FALLBACK_MODELS=         # (пусто) запасные модели через запятую для любого провайдера; для Gemini берётся, если не задан GEMINI_FALLBACK_MODELS
# LLM_CONCURRENCY=1            # (1) параллельные запросы на шаге проверки требований
# REQASK_BATCH_SIZE=6        # (6) требований в одном запросе
# REQASK_CACHE_DIR=.reqask_cache   # кэш ответов модели, пустое значение отключает
# REQASK_CRITIC=1           # (1) шаг 7, перепроверка CRITICAL и MAJOR; 0 выключает, как --no-critic
# REQASK_EDGE=1             # (1) третий проход шага 5, неописанные граничные случаи; 0 выключает, как --no-edge
